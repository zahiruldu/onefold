{
  "name": "onefold",
  "version": "0.1.5",
  "description": "Zero-dependency TypeScript UI framework: fine-grained reactive signals, real-DOM rendering, secure-by-default templating — under 6kb gzipped core, full enterprise features via tree-shakeable sub-paths.",
  "author": "Md. Zahirul Haque <zahirul.arb@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zahiruldu/onefold.git"
  },
  "homepage": "https://onefoldjs.com",
  "bugs": {
    "url": "https://github.com/zahiruldu/onefold/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/onefold.min.js",
  "jsdelivr": "dist/onefold.min.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./virtual-list": {
      "types": "./dist/core/virtual-list.d.ts",
      "import": "./dist/core/virtual-list.js"
    },
    "./suspense": {
      "types": "./dist/core/suspense.d.ts",
      "import": "./dist/core/suspense.js"
    },
    "./transition": {
      "types": "./dist/core/transition.d.ts",
      "import": "./dist/core/transition.js"
    },
    "./http": {
      "types": "./dist/core/http.d.ts",
      "import": "./dist/core/http.js"
    },
    "./form": {
      "types": "./dist/core/form.d.ts",
      "import": "./dist/core/form.js"
    },
    "./i18n": {
      "types": "./dist/core/i18n.d.ts",
      "import": "./dist/core/i18n.js"
    },
    "./persist": {
      "types": "./dist/core/persist.d.ts",
      "import": "./dist/core/persist.js"
    },
    "./theme": {
      "types": "./dist/core/theme.d.ts",
      "import": "./dist/core/theme.js"
    },
    "./guard": {
      "types": "./dist/core/guard.d.ts",
      "import": "./dist/core/guard.js"
    },
    "./observe": {
      "types": "./dist/core/observe.d.ts",
      "import": "./dist/core/observe.js"
    },
    "./plugin": {
      "types": "./dist/core/plugin.d.ts",
      "import": "./dist/core/plugin.js"
    },
    "./remote": {
      "types": "./dist/core/remote.d.ts",
      "import": "./dist/core/remote.js"
    },
    "./stream": {
      "types": "./dist/core/stream.d.ts",
      "import": "./dist/core/stream.js"
    },
    "./a11y": {
      "types": "./dist/core/a11y.d.ts",
      "import": "./dist/core/a11y.js"
    },
    "./interop": {
      "types": "./dist/interop/imperative.d.ts",
      "import": "./dist/interop/imperative.js"
    },
    "./extend": {
      "types": "./dist/core/extend.d.ts",
      "import": "./dist/core/extend.js"
    },
    "./meta": {
      "types": "./dist/core/meta.d.ts",
      "import": "./dist/core/meta.js"
    },
    "./devtools": {
      "types": "./dist/core/devtools.d.ts",
      "import": "./dist/core/devtools.js"
    },
    "./ssr": {
      "types": "./dist/core/ssr.d.ts",
      "import": "./dist/core/ssr.js"
    },
    "./utils": {
      "types": "./dist/core/utils.d.ts",
      "import": "./dist/core/utils.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/fix-extensions.mjs",
    "bundle": "esbuild src/index.ts --bundle --minify --format=esm --outfile=dist/onefold.min.js && esbuild src/full.ts --bundle --minify --format=esm --outfile=dist/onefold.full.min.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/**/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "examples:hero": "esbuild examples/hero-app/main.ts --bundle --format=esm --outfile=examples/hero-app/dist/hero-app.js",
    "examples:blog": "esbuild examples/blog-app/main.ts --bundle --format=esm --outfile=examples/blog-app/dist/blog-app.js",
    "examples:comprehensive": "esbuild examples/comprehensive-app/main.ts --bundle --format=esm --outfile=examples/comprehensive-app/dist/app.js",
    "examples:mfe": "esbuild examples/microfrontend/host/main.ts --bundle --format=esm --outfile=examples/microfrontend/dist/host.js && esbuild examples/microfrontend/remotes/billing-widget.ts --bundle --format=esm --outfile=examples/microfrontend/dist/billing-widget.js && esbuild examples/microfrontend/remotes/analytics-widget.ts --bundle --format=esm --outfile=examples/microfrontend/dist/analytics-widget.js",
    "examples:ssr": "cd examples/ssr-app && npm run build",
    "examples": "npm run examples:hero && npm run examples:blog && npm run examples:comprehensive && npm run examples:mfe && npm run examples:ssr"
  },
  "keywords": [
    "ui",
    "framework",
    "signals",
    "reactive",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.11",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  }
}
