{
  "name": "onefold",
  "version": "0.1.3",
  "description": "Zero-dependency TypeScript UI framework: fine-grained reactive signals, real-DOM rendering, secure-by-default templating, and full-stack enterprise features in under 13kb gzipped.",
  "author": "Md. Zahirul Haque <zahirul.arb@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zahiruldu/onefold.git"
  },
  "homepage": "https://onefoldjs.com",
  "bugs": {
    "url": "https://github.com/zahiruldu/onefold/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/onefold.min.js",
  "jsdelivr": "dist/onefold.min.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc && node scripts/fix-extensions.mjs",
    "bundle": "esbuild src/index.ts --bundle --minify --format=esm --outfile=dist/onefold.min.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/**/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "examples:hero": "esbuild examples/hero-app/main.ts --bundle --format=esm --outfile=examples/hero-app/dist/hero-app.js",
    "examples:blog": "esbuild examples/blog-app/main.ts --bundle --format=esm --outfile=examples/blog-app/dist/blog-app.js",
    "examples:comprehensive": "esbuild examples/comprehensive-app/main.ts --bundle --format=esm --outfile=examples/comprehensive-app/dist/app.js",
    "examples:mfe": "esbuild examples/microfrontend/host/main.ts --bundle --format=esm --outfile=examples/microfrontend/dist/host.js && esbuild examples/microfrontend/remotes/billing-widget.ts --bundle --format=esm --outfile=examples/microfrontend/dist/billing-widget.js && esbuild examples/microfrontend/remotes/analytics-widget.ts --bundle --format=esm --outfile=examples/microfrontend/dist/analytics-widget.js",
    "examples:ssr": "cd examples/ssr-app && npm run build",
    "examples": "npm run examples:hero && npm run examples:blog && npm run examples:comprehensive && npm run examples:mfe && npm run examples:ssr"
  },
  "keywords": [
    "ui",
    "framework",
    "signals",
    "reactive",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.11",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  }
}
